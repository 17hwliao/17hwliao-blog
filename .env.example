# Local browsing and UI development need no GitHub credentials.
# To enable remote saving later, configure your own repository and GitHub App.
NEXT_PUBLIC_GITHUB_OWNER=17hwliao
NEXT_PUBLIC_GITHUB_REPO=17hwliao-blog
NEXT_PUBLIC_GITHUB_BRANCH=main
NEXT_PUBLIC_GITHUB_APP_ID=

# Use your actual domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:2025

# Optional: your own compatible like service. Empty disables likes and all like requests.
NEXT_PUBLIC_LIKE_ENDPOINT=
